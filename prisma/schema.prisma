generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

model Category {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  parentId  String?
  seoTitle  String?
  seoDesc   String?
  image     String?
  position  Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  parent    Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]        @relation("CategoryTree")
  products  ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  bodyHtml       String?
  brandId        String
  productType    String?
  tags           String            @default("[]")
  seoTitle       String?
  seoDescription String?
  photos         String            @default("[]")
  status         String            @default("ACTIVE")
  avgRating      Float             @default(0)
  reviewCount    Int               @default(0)
  sourceHandle   String?
  sourceId       String?
  importedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  categories     ProductCategory[]
  reviews        ProductReview[]
  brand          Brand             @relation(fields: [brandId], references: [id])
  variants       Variant[]
  wishlists      Wishlist[]

  @@index([brandId])
  @@index([status])
  @@map("products")
}

model Variant {
  id            String   @id @default(cuid())
  productId     String
  sku           String?  @unique
  title         String
  size          String?
  color         String?
  price         Int
  comparePrice  Int?
  costPrice     Int?
  ownStock      Int      @default(0)
  supplierStock Int      @default(0)
  weight        Int?
  barcode       String?
  position      Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
  @@index([productId])
  @@map("variants")
}

model ProductCategory {
  productId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ShippingMethod {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  price       Int      @default(0)
  freeFrom    Int?
  active      Boolean  @default(true)
  position    Int      @default(0)
  config      String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  type        String   @default("address")
  orders      Order[]

  @@map("shipping_methods")
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String
  coverImage      String?
  author          String    @default("Qsport.cz")
  tags            String    @default("[]")
  published       Boolean   @default(false)
  publishedAt     DateTime?
  section         String    @default("NOVINKY")
  sportTags       String    @default("[]")
  metaDescription String?
  sources         String    @default("[]")
  relatedProducts String    @default("[]")
  eventDate       DateTime?
  eventLocation   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([section])
  @@map("blog_posts")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  street       String?
  city         String?
  zip          String?
  newsletter   Boolean         @default(false)
  adminNote    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lastLoginAt         DateTime?
  role                String          @default("customer")
  resetToken          String?         @unique
  resetTokenExpiresAt DateTime?
  orders              Order[]
  reviews             ProductReview[]
  wishlists           Wishlist[]

  @@map("users")
}

model Order {
  id                 String         @id @default(cuid())
  orderNumber        String         @unique
  status             String         @default("NEW")
  email              String
  phone              String?
  firstName          String
  lastName           String
  street             String
  city               String
  zip                String
  shippingName       String?
  shippingStreet     String?
  shippingCity       String?
  shippingZip        String?
  shippingId         String
  shippingPrice      Int            @default(0)
  packetaPointId     String?
  packetaPointName   String?
  paymentMethod      String         @default("card")
  paymentStatus      String         @default("PENDING")
  comgateTransId     String?
  subtotal           Int            @default(0)
  discountCode       String?
  discountAmount     Int            @default(0)
  total              Int            @default(0)
  note               String?
  adminNote          String?
  trackingNumber     String?
  trackingUrl        String?
  viewToken          String?
  userId             String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  paidAt             DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  needsSupplierOrder Boolean        @default(false)
  supplierOrderedAt  DateTime?
  supplierReceivedAt DateTime?
  items              OrderItem[]
  user               User?          @relation(fields: [userId], references: [id])
  shipping           ShippingMethod @relation(fields: [shippingId], references: [id])

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([comgateTransId])
  @@index([userId])
  @@index([viewToken])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String?
  variantId         String?
  productName       String
  variantTitle      String
  sku               String?
  quantity          Int     @default(1)
  unitPrice         Int
  totalPrice        Int
  fromOwnStock      Int     @default(0)
  fromSupplierStock Int     @default(0)
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Supplier {
  id               String    @id @default(cuid())
  name             String
  code             String    @unique
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  website          String?
  note             String?
  feedUrl          String
  feedFormat       String
  feedConfig       String    @default("{}")
  active           Boolean   @default(true)
  lastImportAt     DateTime?
  lastImportStatus String?
  lastImportCount  Int?
  lastImportError  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("suppliers")
}

model FeedImportLog {
  id              String   @id @default(cuid())
  supplierId      String
  status          String
  variantsUpdated Int      @default(0)
  variantsCreated Int      @default(0)
  variantsZeroed  Int      @default(0)
  duration        Int      @default(0)
  error           String?
  createdAt       DateTime @default(now())

  @@index([supplierId])
  @@index([createdAt])
  @@map("feed_import_logs")
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String    @default("percentage")
  value          Int
  minOrderAmount Int?
  usageLimit     Int?
  usageCount     Int       @default(0)
  validFrom      DateTime?
  validTo        DateTime?
  active         Boolean   @default(true)
  restrictCategories String?
  restrictBrands     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("discount_codes")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  active       Boolean  @default(true)
  subscribedAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlists")
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  rating     Int
  title      String?
  content    String
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([approved])
  @@map("product_reviews")
}

model AbandonedCheckout {
  id                  String    @id @default(cuid())
  email               String
  phone               String?
  firstName           String?
  lastName            String?
  items               String    @default("[]")
  itemCount           Int       @default(0)
  subtotal            Int       @default(0)
  shippingMethodId    String?
  paymentMethod       String?
  status              String    @default("OPEN")
  recoveredOrderId    String?
  recoveryToken       String    @unique
  recoveryEmailSentAt DateTime?
  recoveredAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("abandoned_checkouts")
}

model AdminLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@map("admin_logs")
}
